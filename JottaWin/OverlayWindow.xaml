<Window x:Class="JottaWin.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JOTTA"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#B0080A0E"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        KeyDown="Window_KeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" VerticalAlignment="Center">
      <Ellipse Width="260" Height="260" Opacity="0.35" HorizontalAlignment="Center">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#80D4B896" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse x:Name="OrbCore" Width="160" Height="160" HorizontalAlignment="Center">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#F0D4B896" Offset="0"/>
            <GradientStop Color="#40281808" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.Effect>
          <DropShadowEffect Color="#D4B896" BlurRadius="32" ShadowDepth="0" Opacity="0.6"/>
        </Ellipse.Effect>
      </Ellipse>
      <TextBlock x:Name="StateLabel" Text="pronto" HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="12" FontWeight="SemiBold" Foreground="#E2E8EF"/>
    </Grid>

    <TextBlock x:Name="ReplyPreview" Grid.Row="1" TextWrapping="Wrap" MaxWidth="520" Margin="24,0,24,12"
               HorizontalAlignment="Center" FontSize="12" Foreground="#7A8794" TextAlignment="Center"/>

    <Border x:Name="ChatPanel" Grid.Row="2" Margin="24,0,24,32" Padding="14" CornerRadius="10"
            Background="#111419" BorderBrush="#1E2228" BorderThickness="1" Visibility="Collapsed">
      <StackPanel>
        <TextBox x:Name="ChatInput" MinHeight="64" MaxHeight="120" AcceptsReturn="True" TextWrapping="Wrap"
                 Background="Transparent" BorderThickness="0" Foreground="#E2E8EF" FontSize="14"
                 CaretBrush="#D4B896" KeyDown="ChatInput_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
          <Button Content="Esc · fechar" Click="CloseChat_Click" Margin="0,0,8,0" Padding="12,6"
                  Background="Transparent" Foreground="#7A8794" BorderBrush="#1E2228"/>
          <Button Content="Enviar" Click="SendChat_Click" Padding="16,6"
                  Background="#D4B896" Foreground="#1A1510" BorderThickness="0"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
